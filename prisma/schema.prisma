generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QmsRecordType {
  AUDIT
  DEVIATION
  CAPA
  CHANGE_CONTROL
  COMPLAINT
  RETURN
}

enum QmsRelationType {
  GENERATES
  RELATED_TO
  IMPLEMENTED_BY
  ASSOCIATED_WITH
}

enum TriState {
  YES
  NO
  NA
}

enum DeviationClassification {
  CRITICAL
  MAJOR
  MINOR
}

enum DeviationStatus {
  DRAFT
  OPEN
  CLOSED
}

enum DataQualityStatus {
  COMPLETE
  INCOMPLETE
  REVIEW_REQUIRED
}

enum DeadlineStatus {
  NOT_EVALUATED
  IN_TIME
  OUT_OF_TIME
  NA
}

enum InvestigationMethod {
  BRAINSTORMING
  FIVE_WHYS
  FTA
  ISHIKAWA
}

enum CapaActionType {
  CORRECTIVE
  PREVENTIVE
}

enum CapaProposalStatus {
  PROPOSED
  REGISTERED
  CANCELLED
}

enum CapaStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum CapaEffectivenessStatus {
  CONFORMING
  NONCONFORMING
  PENDING
  NA
}

enum ChangeControlScope {
  INSTALLATIONS
  EQUIPMENT
  PROCESS
  MATERIAL
  SUPPLIER
  DOCUMENTATION
  OTHER
}

enum ChangeControlClassification {
  MAJOR
  MINOR
}

enum ChangeRequestDecision {
  PENDING
  ACCEPTED
  DENIED
}

enum ChangeDictamenResult {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeExecutionStatus {
  NOT_EXECUTED
  EXECUTED
}

enum ChangeEffectivenessStatus {
  PENDING
  ACCEPTABLE
  NOT_ACCEPTABLE
  NOT_APPLICABLE
}

enum ChangeFinalStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ChangeTaskOrigin {
  DICTAMEN
  FOLLOWUP
}

enum ChangeTaskStatus {
  PENDING
  COMPLETED
  NOT_APPLICABLE
}

enum ComplaintType {
  PROVIDER
  CUSTOMER
}

enum ComplaintClassification {
  CRITICAL
  MAJOR
  MINOR
  NO_GMP_IMPACT
}

enum ComplaintInvestigationResult {
  PROCEDENT
  NOT_PROCEDENT
  INCONCLUSIVE
  NOT_ATTRIBUTABLE_TO_COVEX
}

enum ComplaintStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ComplaintEffectivenessStatus {
  PENDING
  ACCEPTABLE
  NOT_ACCEPTABLE
  NOT_REQUIRED
}

enum ComplaintResolutionAction {
  RETURN
  CORRECTIVE_ACTION
  PREVENTIVE_ACTION
  IMMEDIATE_ACTION
  RECALL
  CREDIT
  REPLACEMENT
  REJECT
  REPROCESS
  DISPOSE
  KEEP_AS_IS
  SUPPLIER_INVESTIGATION
  SUPPLIER_EVALUATION
  OPEN_DEVIATION
  OPEN_CAPA
  OPEN_CHANGE
  OTHER
}

enum ReturnType {
  COMMERCIAL
  COMPLAINT
  RECALL
  EXPIRY
  TRANSPORT
  OTHER
}

enum ReturnProductType {
  API
  INTERMEDIATE
  MEDICINE
  SUPPLEMENT
  IMPORTED_PRODUCT
  MEDICAL_DEVICE
  COSMETIC
  OTHER
}

enum ReturnDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReturnStatus {
  DRAFT
  OPEN
  CLOSED
}

enum HistorySource {
  UI
  IMPORT
  SYSTEM
}

enum ReminderStatus {
  PREPARED
}

enum RecordVersionKind {
  AUDIT_REVISION
  INITIAL
  REOPENING
  FOLLOWUP
  HISTORICAL_STATE
}

enum RecordVersionDocumentKind {
  SIGNED_PDF
  RETURN_ANNEX_III_SIGNED
  RETURN_ANNEX_V_SIGNED
}

enum DocumentType {
  AUDIT_ANNUAL_INTERNAL_PROGRAMME
  AUDIT_ANNUAL_EXTERNAL_PROGRAMME
  AUDIT_INTERNAL_REPORT
  AUDIT_EXTERNAL_REPORT
  AUDIT_CAPA_PLAN
  AUDIT_EXTERNAL_PLAN
  AUDIT_RECEIVED
  AUDIT_RESPONSE
  AUDIT_EVIDENCE
  DEVIATION_ANNEX_III
  DEVIATION_ANNEX_V
  SIMPLE_LIST
  CAPA_ANNEX_III
  CAPA_ANNEX_IV
  CAPA_SIMPLE_LIST
  CHANGE_ANNEX_III
  CHANGE_ANNEX_IV
  CHANGE_ANNEX_V
  CHANGE_ANNEX_VII
  CHANGE_SIMPLE_LIST
  COMPLAINT_ANNEX_III
  COMPLAINT_ANNEX_IV
  COMPLAINT_ANNEX_V
  COMPLAINT_SIMPLE_LIST
  RETURN_ANNEX_III
  RETURN_ANNEX_IV
  RETURN_ANNEX_V
  RETURN_ANNEX_VI
  RETURN_SIMPLE_LIST
}

enum HistoricalImportRowResult {
  IMPORTED
  SKIPPED_DUPLICATE
  REJECTED
  REVIEW_REQUIRED
}

enum FormVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ConfigFieldKind {
  STRUCTURAL
  VERSIONED
  OPERATIONAL
  DERIVED
}

enum ConfigValueType {
  TEXT
  LONG_TEXT
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTISELECT
  NUMBER
  REFERENCE
}

enum ParameterValueType {
  TEXT
  INTEGER
  BOOLEAN
  JSON
}

enum AlertRuleKind {
  FOLLOWUP_DUE
  EFFECTIVENESS_PENDING
  PLANNED_EXECUTION_DUE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReviewThreadStatus {
  PENDING
  ACCEPTED
  RESOLVED
}

enum ReviewTargetKind {
  RECORD
  SECTION
  FIELD
  ITEM
}

model QmsRecord {
  id                 String              @id @default(uuid())
  recordType         QmsRecordType
  businessCode       String?
  annulledBusinessCode String?
  year               Int?
  isActive           Boolean             @default(true)
  annulledAt         DateTime?
  annulledByText     String?
  annulledReason     String?              @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  audit              Audit?
  deviation          Deviation?
  capa               Capa?
  changeControl       ChangeControl?
  complaint           Complaint?
  returnRecord        ReturnRecord?
  sourceRelations    QmsRelation[]       @relation("RelationSource")
  targetRelations    QmsRelation[]       @relation("RelationTarget")
  history            ChangeHistory[]
  versions           QmsRecordVersion[]
  reviewThreads      ReviewThread[]
  generatedDocuments GeneratedDocument[]
  reminders          ReminderLog[]
  linkedCapaPlans    DeviationCapaPlan[] @relation("LinkedCapaRecord")
  complaintLinkedCapaPlans ComplaintCapaPlan[] @relation("ComplaintLinkedCapaRecord")
  historicalImports  HistoricalImportRow[]

  @@unique([recordType, businessCode])
  @@index([recordType, year])
  @@index([recordType, isActive])
  @@index([businessCode])
  @@index([annulledBusinessCode])
}

model QmsRelation {
  auditFindingRelations AuditFindingRelation[]
  id             String          @id @default(uuid())
  sourceRecordId String
  sourceRecord   QmsRecord       @relation("RelationSource", fields: [sourceRecordId], references: [id], onDelete: Restrict)
  targetRecordId String
  targetRecord   QmsRecord       @relation("RelationTarget", fields: [targetRecordId], references: [id], onDelete: Restrict)
  relationType   QmsRelationType
  createdAt      DateTime        @default(now())
  createdByText  String?
  notes          String?
  isActive       Boolean         @default(true)

  @@unique([sourceRecordId, targetRecordId, relationType])
  @@index([sourceRecordId, isActive])
  @@index([targetRecordId, isActive])
}

model Department {
  authorizedUsers AuthUserDepartment[]
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  isActive   Boolean     @default(true)
  validFrom  DateTime?   @db.Date
  validTo    DateTime?   @db.Date
  controlledDocuments ControlledDocument[]
  auditDepartments AuditDepartment[]
  codingAudits Audit[] @relation("AuditCodingDepartment")
  auditPlanEntries AuditPlanEntry[]
  deviations Deviation[]
  capas      Capa[]
  changeControls ChangeControl[]
  changeTasks ChangeControlTask[]
  complaints Complaint[]
  returnRecords ReturnRecord[]
  returnProducts ReturnProduct[]
}

model FormVersion {
  id            String            @id @default(uuid())
  module        QmsRecordType
  versionCode   String
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  isActive      Boolean           @default(true)
  status        FormVersionStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deviations    Deviation[]
  capas         Capa[]
  changeControls ChangeControl[]
  complaints Complaint[]
  returnRecords ReturnRecord[]
  fieldConfigs  FormFieldConfig[]

  @@unique([module, versionCode])
  @@index([module, isActive, effectiveFrom])
  @@index([module, status])
}

model FormFieldConfig {
  id                   String           @id @default(uuid())
  formVersionId        String
  formVersion          FormVersion      @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fieldKey             String
  label                String
  sectionKey           String
  sectionLabel         String
  sortOrder            Int
  kind                 ConfigFieldKind
  valueType            ConfigValueType
  required             Boolean          @default(false)
  listAvailable        Boolean          @default(false)
  listVisibleByDefault Boolean          @default(false)
  filterable           Boolean          @default(false)
  simpleExport         Boolean          @default(false)
  officialAnnexField   Boolean          @default(false)
  editableDefinition   Boolean          @default(false)
  options              Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([formVersionId, fieldKey])
  @@index([formVersionId, sectionKey, sortOrder])
  @@index([formVersionId, listAvailable, listVisibleByDefault])
}

model TemplateVersion {
  annualProgrammes AuditAnnualProgrammeVersion[]
  id                  String              @id @default(uuid())
  module              QmsRecordType
  documentType        DocumentType
  versionCode         String
  filePath            String?
  fileName            String?
  mimeType            String?
  fileData            Bytes?
  fileSize            Int?
  checksum            String?
  effectiveFrom       DateTime            @db.Date
  effectiveTo         DateTime?           @db.Date
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  deviationsAnnexIII  Deviation[]         @relation("DeviationAnnexIIITemplate")
  capasAnnexIII       Capa[]              @relation("CapaAnnexIIITemplate")
  changeRequests      ChangeControl[]      @relation("ChangeAnnexIIITemplate")
  changeDictamens     ChangeControl[]      @relation("ChangeAnnexIVTemplate")
  changeFollowups     ChangeControl[]      @relation("ChangeAnnexVTemplate")
  complaintsAnnexIII  Complaint[]          @relation("ComplaintAnnexIIITemplate")
  complaintsAnnexIV   Complaint[]          @relation("ComplaintAnnexIVTemplate")
  complaintsAnnexV    Complaint[]          @relation("ComplaintAnnexVTemplate")
  returnsAnnexIII     ReturnRecord[]       @relation("ReturnAnnexIIITemplate")
  returnsAnnexIV      ReturnRecord[]       @relation("ReturnAnnexIVTemplate")
  returnsAnnexV       ReturnRecord[]       @relation("ReturnAnnexVTemplate")
  returnsAnnexVI      ReturnRecord[]       @relation("ReturnAnnexVITemplate")
  generatedDocuments  GeneratedDocument[]

  @@unique([module, documentType, versionCode])
  @@index([module, documentType, isActive, effectiveFrom])
}

model Deviation {
  id                         String                   @id @default(uuid())
  qmsRecordId                String                   @unique
  qmsRecord                  QmsRecord                @relation(fields: [qmsRecordId], references: [id], onDelete: Restrict)
  departmentId               String?
  department                 Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot     String?
  departmentNameSnapshot     String?
  issueDate                  DateTime?                @db.Date
  eventDateTime              DateTime?
  detectedBy                 String?
  createdByText               String?
  materialProcessAffected     String?
  provenance                  String?
  deadlineStatus              DeadlineStatus           @default(NOT_EVALUATED)
  formVersionId              String?
  formVersion                FormVersion?             @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  anexoIIITemplateVersionId  String?
  anexoIIITemplateVersion    TemplateVersion?         @relation("DeviationAnnexIIITemplate", fields: [anexoIIITemplateVersionId], references: [id], onDelete: Restrict)
  processEquipmentSystem     String?
  finishedProductSystem      String?
  productLot                 String?
  lotSize                    String?
  affectedQuantity           String?
  client                     String?
  rawOrPackagingMaterial     String?
  materialLot                String?
  materialLotSize            String?
  materialAffectedQuantity   String?
  supplier                   String?
  supplierLot                String?
  affectedEquipmentLine      String?
  otherOrigin                String?
  affectedDocumentation      String?
  whatHappened               String?
  whoInvolved                String?
  whenHappened               String?
  whereHappened              String?
  howHappened                String?
  investigation              String?
  investigationConclusive    TriState?
  investigationMethods       InvestigationMethod[]    @default([])
  rootCause                  String?
  recurrentRootCause         TriState?
  recurrenceDetails          String?
  classification             DeviationClassification?
  validationImpact           TriState?
  registrationImpact         TriState?
  stabilityImpact            TriState?
  otherProcessesImpact       TriState?
  otherProcessesImpactDetails String?
  affectsFinishedProduct     TriState?
  capaRequired               Boolean?
  conclusion                 String?
  disposition                String?
  dispositionQuantity        String?
  dispositionComments        String?
  clientNotification         TriState?
  closedAt                   DateTime?                @db.Date
  status                     DeviationStatus          @default(OPEN)
  internalObservations       String?
  signedDocumentAvailable    Boolean?
  dataQualityStatus          DataQualityStatus        @default(REVIEW_REQUIRED)
  includeInKpi              Boolean                  @default(true)
  kpiExclusionReason        String?
  extraData                  Json?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  immediateActions           DeviationImmediateAction[]
  followups                  DeviationFollowup[]
  capaPlans                  DeviationCapaPlan[]

  @@index([departmentId])
  @@index([status])
  @@index([classification])
  @@index([provenance])
  @@index([deadlineStatus])
  @@index([includeInKpi])
  @@index([issueDate])
  @@index([closedAt])
}

model DeviationImmediateAction {
  id          String    @id @default(uuid())
  deviationId String
  deviation   Deviation @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  description String
  executedBy  String?
  executedAt  DateTime? @db.Date
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([deviationId, sortOrder])
}

model DeviationFollowup {
  id                String    @id @default(uuid())
  deviationId       String
  deviation         Deviation @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  followupDate      DateTime  @db.Date
  completedByText   String
  followupType      String?
  comment           String
  nextFollowupDate  DateTime? @db.Date
  evidenceReference String?
  createdAt         DateTime  @default(now())

  @@index([deviationId, followupDate])
  @@index([nextFollowupDate])
}

model DeviationCapaPlan {
  id                   String             @id @default(uuid())
  deviationId          String
  deviation            Deviation          @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  actionType           CapaActionType
  description          String
  plannedExecutionDate DateTime?          @db.Date
  responsible          String?
  businessCapaCode     String?
  linkedCapaRecordId   String?
  linkedCapaRecord     QmsRecord?         @relation("LinkedCapaRecord", fields: [linkedCapaRecordId], references: [id], onDelete: SetNull)
  proposalStatus       CapaProposalStatus @default(PROPOSED)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([deviationId])
  @@index([linkedCapaRecordId])
  @@index([plannedExecutionDate])
}


model Capa {
  id                        String                  @id @default(uuid())
  qmsRecordId               String                  @unique
  qmsRecord                 QmsRecord               @relation(fields: [qmsRecordId], references: [id], onDelete: Restrict)
  actionType                CapaActionType
  departmentId              String?
  department                Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot    String?
  departmentNameSnapshot    String?
  openedAt                  DateTime?               @db.Date
  createdByText             String?
  originType                String?
  originCode                String?
  applicableTo              String?
  defectDescription         String?
  rootCause                 String?
  impactAssessment          String?
  nextFollowupDate          DateTime?               @db.Date
  actionFollowupObservations String?
  operationalStatusDescription String?
  operationalClosedAt       DateTime?               @db.Date
  status                    CapaStatus              @default(OPEN)
  cancellationReason        String?
  effectivenessStatus       CapaEffectivenessStatus @default(PENDING)
  effectivenessCriteria     String?
  effectivenessAssessment   String?
  effectivenessEvidence     String?
  effectiveClosedAt         DateTime?               @db.Date
  conclusion                String?
  internalObservations      String?
  signedDocumentAvailable   Boolean?
  dataQualityStatus         DataQualityStatus       @default(REVIEW_REQUIRED)
  includeInKpi              Boolean                 @default(true)
  kpiExclusionReason        String?
  formVersionId             String?
  formVersion               FormVersion?            @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  annexIIITemplateVersionId String?
  annexIIITemplateVersion   TemplateVersion?        @relation("CapaAnnexIIITemplate", fields: [annexIIITemplateVersionId], references: [id], onDelete: Restrict)
  extraData                 Json?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  plannedActions            CapaPlannedAction[]
  actionFollowups           CapaActionFollowup[]
  followups                 CapaFollowup[]

  @@index([departmentId])
  @@index([actionType])
  @@index([status])
  @@index([effectivenessStatus])
  @@index([openedAt])
  @@index([nextFollowupDate])
  @@index([operationalClosedAt])
  @@index([effectiveClosedAt])
  @@index([includeInKpi])
}

model CapaPlannedAction {
  id                   String   @id @default(uuid())
  capaId               String
  capa                 Capa     @relation(fields: [capaId], references: [id], onDelete: Cascade)
  description          String
  responsible          String?
  plannedExecutionDate DateTime? @db.Date
  impact               String?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([capaId, sortOrder])
  @@index([plannedExecutionDate])
}

model CapaActionFollowup {
  id           String   @id @default(uuid())
  capaId       String
  capa         Capa     @relation(fields: [capaId], references: [id], onDelete: Cascade)
  followupDate DateTime? @db.Date
  description  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([capaId, sortOrder])
  @@index([followupDate])
}

model CapaFollowup {
  id                String   @id @default(uuid())
  capaId            String
  capa              Capa     @relation(fields: [capaId], references: [id], onDelete: Cascade)
  sequenceNumber    Int
  followupDate      DateTime @db.Date
  completedByText   String
  reason            String?
  description       String
  observations      String?
  evidenceReference String?
  nextFollowupDate  DateTime? @db.Date
  createdAt         DateTime @default(now())

  @@unique([capaId, sequenceNumber])
  @@index([capaId, followupDate])
  @@index([nextFollowupDate])
}

model ChangeControl {
  id                         String                    @id @default(uuid())
  qmsRecordId                String                    @unique
  qmsRecord                  QmsRecord                 @relation(fields: [qmsRecordId], references: [id], onDelete: Restrict)
  departmentId               String?
  department                 Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot     String?
  departmentNameSnapshot     String?
  requestDate                DateTime?                 @db.Date
  requesterName              String?
  requesterPosition          String?
  scope                      ChangeControlScope[]      @default([])
  otherScope                 String?
  description                String?
  justification              String?
  providedDocuments          String?
  requestDecision            ChangeRequestDecision     @default(PENDING)
  requestDecisionResponsible String?
  requestDecisionRole        String?
  requestDecisionDate        DateTime?                 @db.Date
  evaluation                 String?
  classification             ChangeControlClassification?
  plannedImplementationDate  DateTime?                 @db.Date
  committeeRequired          Boolean?
  committeeDetails           String?
  clientNotificationRequired Boolean?
  clientNotificationDetails  String?
  authorityRequired          Boolean?
  authorityDetails           String?
  pqrRequired                TriState?
  pqrProducts                String?
  pqrPeriod                  String?
  stabilityRequired          TriState?
  stabilityAccelerated       Boolean                   @default(false)
  stabilityOngoing           Boolean                   @default(false)
  additionalAnalysisRequired TriState?
  additionalAnalysisDetails  String?
  additionalValidationRequired TriState?
  additionalValidationDetails String?
  otherImplicationRequired   Boolean?
  otherImplicationDetails    String?
  dictamenResult             ChangeDictamenResult      @default(PENDING)
  dictamenDate               DateTime?                 @db.Date
  followupResponsible        String?
  dictamenObservations       String?
  approvalNames              String?
  executionStatus            ChangeExecutionStatus     @default(NOT_EXECUTED)
  executionDate              DateTime?                 @db.Date
  operationalClosedAt        DateTime?                 @db.Date
  effectivenessStatus        ChangeEffectivenessStatus @default(PENDING)
  effectiveClosedAt          DateTime?                 @db.Date
  finalStatus                ChangeFinalStatus         @default(OPEN)
  closureConclusion          String?
  internalObservations       String?
  signedDocumentAvailable    Boolean?
  dataQualityStatus          DataQualityStatus         @default(REVIEW_REQUIRED)
  includeInKpi               Boolean                   @default(true)
  kpiExclusionReason         String?
  formVersionId              String?
  formVersion                FormVersion?              @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  annexIIITemplateVersionId  String?
  annexIIITemplateVersion    TemplateVersion?          @relation("ChangeAnnexIIITemplate", fields: [annexIIITemplateVersionId], references: [id], onDelete: Restrict)
  annexIVTemplateVersionId   String?
  annexIVTemplateVersion     TemplateVersion?          @relation("ChangeAnnexIVTemplate", fields: [annexIVTemplateVersionId], references: [id], onDelete: Restrict)
  annexVTemplateVersionId    String?
  annexVTemplateVersion      TemplateVersion?          @relation("ChangeAnnexVTemplate", fields: [annexVTemplateVersionId], references: [id], onDelete: Restrict)
  extraData                  Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  tasks                      ChangeControlTask[]
  followups                  ChangeControlFollowup[]

  @@index([departmentId])
  @@index([requestDate])
  @@index([classification])
  @@index([dictamenResult])
  @@index([executionStatus])
  @@index([effectivenessStatus])
  @@index([finalStatus])
  @@index([plannedImplementationDate])
  @@index([includeInKpi])
}

model ChangeControlTask {
  id                    String             @id @default(uuid())
  changeControlId       String
  changeControl         ChangeControl      @relation(fields: [changeControlId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot String?
  departmentNameSnapshot String?
  description           String
  responsible           String?
  plannedDate           DateTime?          @db.Date
  origin                ChangeTaskOrigin
  introducedInFollowup  Int?
  sortOrder             Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  states                ChangeControlTaskState[]

  @@index([changeControlId, origin, sortOrder])
  @@index([departmentId])
  @@index([plannedDate])
}

model ChangeControlFollowup {
  id                    String                    @id @default(uuid())
  changeControlId       String
  changeControl         ChangeControl             @relation(fields: [changeControlId], references: [id], onDelete: Cascade)
  sequenceNumber        Int
  followupDate          DateTime                  @db.Date
  responsible           String
  observations          String?
  executionStatus       ChangeExecutionStatus
  executionDate         DateTime?                 @db.Date
  effectivenessStatus   ChangeEffectivenessStatus
  effectivenessObservations String?
  closeChange           Boolean                   @default(false)
  nextFollowupDate      DateTime?                 @db.Date
  remainOpenReason      String?
  conclusion            String?
  approvalByText        String?
  createdAt             DateTime                  @default(now())
  taskStates            ChangeControlTaskState[]

  @@unique([changeControlId, sequenceNumber])
  @@index([changeControlId, followupDate])
  @@index([nextFollowupDate])
}

model ChangeControlTaskState {
  id              String                @id @default(uuid())
  followupId      String
  followup        ChangeControlFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
  taskId          String
  task            ChangeControlTask     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  status          ChangeTaskStatus
  actualDate      DateTime?             @db.Date
  evidenceComment String?
  createdAt       DateTime              @default(now())

  @@unique([followupId, taskId])
  @@index([taskId])
}

model Complaint {
  id                         String                       @id @default(uuid())
  qmsRecordId                String                       @unique
  qmsRecord                  QmsRecord                    @relation(fields: [qmsRecordId], references: [id], onDelete: Restrict)
  departmentId               String?
  department                 Department?                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot     String?
  departmentNameSnapshot     String?
  openedAt                   DateTime?                    @db.Date
  detectionDate              DateTime?                    @db.Date
  detectedBy                 String?
  createdByText              String?
  complaintType              ComplaintType
  receptionDate              DateTime?                    @db.Date
