  department             Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot String
  departmentNameSnapshot String
  isActive               Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([auditId, departmentId])
  @@index([departmentId, isActive])
}

model AuditParticipant {
  id           String               @id @default(uuid())
  auditId      String
  audit        Audit                @relation(fields: [auditId], references: [id], onDelete: Restrict)
  displayName  String
  position     String?
  organization String?
  role         AuditParticipantRole
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([auditId, sortOrder])
}


enum AuditFindingType {
  FINDING
  RECOMMENDATION
  CLIENT_OBSERVATION
  AUTHORITY_OBSERVATION
}

enum AuditFindingCriticality {
  CRITICAL
  MAJOR
  MINOR
  NA
}

enum AuditActionStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  NOT_APPLICABLE
}

model AuditFinding {
  id String @id @default(uuid())
  auditId String
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Restrict)
  reference String
  findingType AuditFindingType
  criticality AuditFindingCriticality @default(NA)
  description String @db.Text
  criterionReference String? @db.Text
  objectiveEvidence String? @db.Text
  treatment String? @db.Text
  treatmentStatus AuditActionStatus @default(OPEN)
  closedAt DateTime? @db.Date
  evidence String? @db.Text
  evidenceReference String? @db.Text
  verificationComment String? @db.Text
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  retiredAt DateTime?
  retiredByText String?
  retirementReason String? @db.Text
  createdByText String
  updatedByText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions AuditFindingAction[]
  followups AuditFollowup[]
  relations AuditFindingRelation[]

  @@unique([auditId, reference])
  @@index([auditId, isActive, sortOrder])
  @@index([criticality, isActive])
}

model AuditFindingAction {
  verificationResult  CapaEffectivenessStatus @default(PENDING)
  verifiedAt          DateTime?               @db.Date
  verifiedBy          String?
  id String @id @default(uuid())
  findingId String
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  description String @db.Text
  responsible String?
  targetDate DateTime? @db.Date
  status AuditActionStatus @default(OPEN)
  closedAt DateTime? @db.Date
  evidence String? @db.Text
  evidenceReference String? @db.Text
  verificationComment String? @db.Text
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  retiredAt DateTime?
  retiredByText String?
  retirementReason String? @db.Text
  createdByText String
  updatedByText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId, isActive, sortOrder])
  @@index([status, targetDate])
}

model AuditFindingRelation {
  id String @id @default(uuid())
  findingId String
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  qmsRelationId String
  qmsRelation QmsRelation @relation(fields: [qmsRelationId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  createdByText String
  updatedByText String?
  retiredAt DateTime?
  retiredByText String?
  retirementReason String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([findingId, qmsRelationId])
  @@index([qmsRelationId, isActive])
}

model AuditFollowup {
  id String @id @default(uuid())
  auditId String
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Restrict)
  findingId String?
  finding AuditFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)
  followupDate DateTime @db.Date
  completedByText String
  description String @db.Text
  nextReviewDate DateTime? @db.Date
  evidenceReference String? @db.Text
  createdByText String
  updatedByText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId, followupDate])
  @@index([findingId, followupDate])
  @@index([nextReviewDate])
}


// P1A: independent master/revisions. Approval events and assets belong to P2/P3.
enum ControlledDocumentType {
  PNT
  TECHNICAL_INSTRUCTION
}

enum ControlledDocumentAdministrativeStatus {
  DRAFT
  ACTIVE
  ANNULLED
}

enum ControlledDocumentRevisionStatus {
  IMPORTED_PENDING
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED_PENDING_EFFECTIVE
  IN_FORCE
  OBSOLETE
  ANNULLED
}

enum ControlledDocumentVerificationStatus {
  UNVERIFIED
  VERIFIED
  REVIEW_REQUIRED
}

model ControlledDocument {
  id String @id @default(uuid())
  baseCode String? @unique
  title String? @db.Text
  documentType ControlledDocumentType @default(PNT)
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCodeSnapshot String?
  departmentNameSnapshot String?
  administrativeStatus ControlledDocumentAdministrativeStatus @default(DRAFT)
  observations String? @db.Text
  sourceMetadata Json?
  verificationStatus ControlledDocumentVerificationStatus @default(UNVERIFIED)
  createdByText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  annulledAt DateTime?
  annulledByText String?
  annulmentReason String? @db.Text
  revisions ControlledDocumentRevision[]
  changes ControlledDocumentChange[]

  @@index([departmentId, administrativeStatus])
  @@index([administrativeStatus, createdAt])
}

model ControlledDocumentRevision {
  id String @id @default(uuid())
  documentId String
  document ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revisionCode String
  baseCodeSnapshot String?
  titleSnapshot String? @db.Text
  departmentCodeSnapshot String?
  departmentNameSnapshot String?
  revisionReason String? @db.Text
  status ControlledDocumentRevisionStatus @default(DRAFT)
  effectiveFrom DateTime? @db.Date
  reviewDueAt DateTime? @db.Date
  obsoletedAt DateTime? @db.Date
  previousRevisionId String?
  previousRevision ControlledDocumentRevision? @relation("ControlledPreviousRevision", fields: [documentId, previousRevisionId], references: [documentId, id], onDelete: Restrict, onUpdate: NoAction)
  followingRevisions ControlledDocumentRevision[] @relation("ControlledPreviousRevision")
  sourceReference String? @db.Text
  sourceMetadata Json?
  verificationStatus ControlledDocumentVerificationStatus @default(UNVERIFIED)
  verifiedByText String?
  verifiedAt DateTime?
  consolidatedAt DateTime?
  registeredByText String
  registeredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  changes ControlledDocumentChange[]
  documents ControlledRevisionDocument[]
  lifecycle ControlledRevisionLifecycle?
  decisions ControlledRevisionDecision[]

  @@unique([documentId, revisionCode])
  @@unique([documentId, id])
  @@index([status, effectiveFrom, reviewDueAt])
  @@index([documentId, revisionCode])
}

model ControlledDocumentChange {
  authenticatedUserId String? @db.Uuid
  authenticatedUser AuthUser? @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  documentId String
  document ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revisionId String?
  revision ControlledDocumentRevision? @relation(fields: [documentId, revisionId], references: [documentId, id], onDelete: Restrict, onUpdate: NoAction)
  action String
  oldValue Json?
  newValue Json?
  changedByText String
  reason String @db.Text
  source HistorySource @default(UI)
  changedAt DateTime @default(now())

  @@index([documentId, changedAt, id])
  @@index([revisionId])
}

// P2A: immutable documentary objects, separate from revision snapshots.
model ControlledRevisionDocument {
  authenticatedUserId String? @db.Uuid
  authenticatedUser AuthUser? @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  documentId String
  revisionId String
  revision ControlledDocumentRevision @relation(fields: [documentId, revisionId], references: [documentId, id], onDelete: Restrict, onUpdate: NoAction)
  originalName String
  kind String
  state String
  mimeType String?
  sizeBytes Int?
  sha256 String?
  fileData Bytes?
  storageReference String @unique
  externalReference String? @db.Text
  description String? @db.Text
  incorporatedAt DateTime @default(now())
  incorporatedBy String
  identitySource String
  replacesId String? @unique
  replacementReason String? @db.Text
  replaces ControlledRevisionDocument? @relation("DocumentReplacement", fields: [revisionId, replacesId], references: [revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  replacement ControlledRevisionDocument? @relation("DocumentReplacement")
  decisionEvidence ControlledDecisionEvidence[]

  @@unique([revisionId, id])
  @@unique([revisionId, replacesId])
  @@index([documentId, revisionId, incorporatedAt])
}

// P2B: operational dates are separate from frozen imported/legacy dates.
model ControlledRevisionLifecycle {
  revisionId String @id
  documentId String
  revision ControlledDocumentRevision @relation(fields: [documentId, revisionId], references: [documentId, id], onDelete: Restrict, onUpdate: NoAction)
  version Int @default(0)
  legacyOrigin Boolean @default(false)
  approvalAt DateTime? @db.Date
  effectiveFrom DateTime? @db.Date
  reviewDueAt DateTime? @db.Date
  obsoletedAt DateTime? @db.Date
  @@unique([documentId, revisionId])
}

model ControlledRevisionDecision {
  authenticatedUserId String? @db.Uuid
  authenticatedUser AuthUser? @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  documentId String
  revisionId String
  revision ControlledDocumentRevision @relation(fields: [documentId, revisionId], references: [documentId, id], onDelete: Restrict, onUpdate: NoAction)
  sequence Int
  requestId String @unique
  requestHash String
  operation String
  result String?
  actor String
  identitySource String
  decidedAt DateTime @default(now())
  reason String @db.Text
  oldState ControlledDocumentRevisionStatus
  newState ControlledDocumentRevisionStatus
  details Json
  before Json
  after Json
  rectifiesId String?
  rectifies ControlledRevisionDecision? @relation("DecisionCorrection", fields: [revisionId, rectifiesId], references: [revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  corrections ControlledRevisionDecision[] @relation("DecisionCorrection")
  evidence ControlledDecisionEvidence[]
  @@unique([revisionId, id])
  @@unique([revisionId, sequence])
  @@index([documentId, revisionId, decidedAt])
}

model ControlledDecisionEvidence {
  id String @id @default(uuid())
  revisionId String
  decisionId String
  documentObjectId String
  decision ControlledRevisionDecision @relation(fields: [revisionId, decisionId], references: [revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  documentObject ControlledRevisionDocument @relation(fields: [revisionId, documentObjectId], references: [revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshot Json
  @@unique([decisionId, documentObjectId])
}

// P1B-2: bounded staging; no original workbook binary.
model ControlledDocumentImportBatch {
  id String @id @default(uuid())
  fileName String
  sha256 String
  analyzedAt DateTime
  actor String
  state String @default("PENDING")
  version Int @default(0)
  summary Json
  reportMetadata Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  confirmedAt DateTime?
  rows ControlledDocumentImportRow[]
  events ControlledDocumentImportEvent[]
  @@index([state, expiresAt])
  @@index([sha256])
}

model ControlledDocumentImportRow {
  id String @id @default(uuid())
  batchId String
  batch ControlledDocumentImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceKey String
  baseCode String?
  data Json
  decision String @default("PENDING")
  resolution Json?
  baseline String?
  decidedBy String?
  decidedAt DateTime?
  result Json?
  @@unique([batchId, sourceKey])
  @@index([batchId, decision])
}

model ControlledDocumentImportEvent {
  authenticatedUserId String? @db.Uuid
  authenticatedUser AuthUser? @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  batchId String
  batch ControlledDocumentImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  action String
  actor String
  detail Json
  createdAt DateTime @default(now())
  @@index([batchId, createdAt, id])
}

// Programme issuance is independent from individual audit record versions.
model AuditAnnualProgrammeVersion {
  authenticatedUserId String? @db.Uuid
  authenticatedUser AuthUser? @relation(fields: [authenticatedUserId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  planId String
  plan AuditAnnualPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sequenceNumber Int
  requestId String
  requestHash String
  contentFingerprint String
  snapshot Json
  templateVersionId String
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  templateChecksum String
  reference String
  generatedAt DateTime @default(now())
  generatedBy String
  reason String @db.Text
  fileName String
  mimeType String
  fileData Bytes
  fileSize Int
  checksum String

  @@unique([planId, sequenceNumber])
  @@unique([planId, requestId])
  @@index([planId, generatedAt])
}

enum AccessModule {
 DEVIATION
 CAPA
 CHANGE_CONTROL
 COMPLAINT
 RETURN
 AUDIT
 PNT
 SYSTEM
}
enum AccessPermission {
 READ
 CREATE
 EDIT
 FOLLOWUP
 REVIEW
 CLOSE
 ANNUL
 DOWNLOAD
 EXPORT
 IMPORT
 MANAGE_CONFIGURATION
 MANAGE_USERS
 ATTACH_DOCUMENT
 GENERATE_DOCUMENT
 AUDIT_ISSUE_REPORT
 AUDIT_ISSUE_PROGRAMME
 PNT_VERIFY
 PNT_RECORD_APPROVAL
 PNT_ACCEPT_APPROVAL
 PNT_ACTIVATE
 PNT_RETIRE
 PNT_CORRECT
 PNT_LEGACY_REGISTER
 PNT_MANAGE_STATE
}
enum AccessScope {
 ALL
 ASSIGNED
}
model AuthUser {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 objectId String @db.Uuid
 displayName String
 email String
 active Boolean @default(false)
 authorizedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 roles AuthUserRole[]
 departments AuthUserDepartment[]
 assignments AuthRecordAssignment[]
 sessions AuthSession[]
 administrativeChanges AuthAuthorizationChange[]
 authoredChangeHistory ChangeHistory[]
 authoredQmsRecordVersion QmsRecordVersion[]
 authoredReviewThread ReviewThread[]
 authoredReviewMessage ReviewMessage[]
 authoredGeneratedDocument GeneratedDocument[]
 authoredConfigurationChange ConfigurationChange[]
 authoredAuditPlanChange AuditPlanChange[]
 authoredControlledDocumentChange ControlledDocumentChange[]
 authoredControlledRevisionDocument ControlledRevisionDocument[]
 authoredControlledRevisionDecision ControlledRevisionDecision[]
 authoredControlledDocumentImportEvent ControlledDocumentImportEvent[]
 authoredAuditAnnualProgrammeVersion AuditAnnualProgrammeVersion[]
 @@unique([tenantId, objectId])
}
model AuthRole {
 id String @id @default(uuid()) @db.Uuid
 key String @unique
 name String
 qaAcceptedAt DateTime?
 qaAcceptedBy String?
 createdAt DateTime @default(now())
 users AuthUserRole[]
 permissions AuthRolePermission[]
}
model AuthRolePermission {
 id String @id @default(uuid()) @db.Uuid
 roleId String @db.Uuid
 role AuthRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
 module AccessModule
 permission AccessPermission
 scope AccessScope
 @@unique([roleId, module, permission])
}
model AuthUserRole {
 userId String @db.Uuid
 roleId String @db.Uuid
 user AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
 role AuthRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
 assignedAt DateTime @default(now())
 @@id([userId, roleId])
}
model AuthUserDepartment {
 userId String @db.Uuid
 departmentId String
 user AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
 department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
 @@id([userId, departmentId])
}
model AuthRecordAssignment {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
 module AccessModule
 recordId String @db.Uuid
 @@unique([userId, module, recordId])
}
model AuthSession {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 csrfHash String
 userId String @db.Uuid
 user AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
 createdAt DateTime @default(now())
 expiresAt DateTime
 lastSeenAt DateTime @default(now())
 revokedAt DateTime?
 @@index([userId, revokedAt])
 @@index([expiresAt])
}
model AuthLoginAttempt {
 id String @id
 state String
 nonce String
 verifier String
 returnTo String
 expiresAt DateTime
 @@index([expiresAt])
}
model AuthAuthorizationChange {
 id String @id @default(uuid()) @db.Uuid
 actorUserId String? @db.Uuid
 actorUser AuthUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
 source String
 targetUserId String?
 action String
 oldValue Json?
 newValue Json?
 reason String
 createdAt DateTime @default(now())
}
