  notes         String?        @db.Text
  createdByText String
  updatedByText String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entries       AuditPlanEntry[]
  changes       AuditPlanChange[]

  @@unique([year, auditType])
  @@index([auditType, year])
}

model AuditPlanEntry {
  plannedPeriodText String?
  plannedAuditorsText String? @db.Text
  productService String? @db.Text
  plannedScope String? @db.Text
  plannedModality AuditModality?
  programmeArea String?
  id             String         @id @default(uuid())
  planId         String
  plan           AuditAnnualPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subject        String         @db.Text
  targetName     String?
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  plannedDate    DateTime?      @db.Date
  notes          String?        @db.Text
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdByText  String
  updatedByText  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  audit          Audit?

  @@index([planId, isActive, sortOrder])
}

