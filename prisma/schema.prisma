enum AuditType {
  INTERNAL
  EXTERNAL
}

enum AuditScenario {
  INTERNAL_COVEX
  INTERNAL_CONTRACTED
  SUPPLIER
  CLIENT
  AUTHORITY
}

enum AuditStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AuditPlanningStatus {
  UNCLASSIFIED
  PLANNED
  OUT_OF_PLAN
}

enum AuditModality {
  ONSITE
  REMOTE
  HYBRID
}

enum AuditParticipantRole {
  LEAD_AUDITOR
  AUDITOR
  AUDITEE
}

model Audit {
  reportDate                   DateTime?          @db.Date
  conclusion                   String?            @db.Text
  programme                    String?            @db.Text
  previousAuditBackground      String?            @db.Text
  supplierType                 String?
  auditedContact               String?            @db.Text
  planIntroduction             String?            @db.Text
  activityDuration             String?            @db.Text
  reportDistribution           String?            @db.Text
  preparedBy                   String?
  preparedPosition             String?
  reviewedBy                   String?
  reviewedPosition             String?
  receivedBy                   String?
  receivedPosition             String?
  capaPlanDate                 DateTime?          @db.Date
  capaPlanEstablishedAt        DateTime?          @db.Date
  reportSentAt                 DateTime?          @db.Date
  supplierResponseReceivedAt   DateTime?          @db.Date
  responseRequired             Boolean            @default(false)
  responseSentAt               DateTime?          @db.Date
  closureEvidence              String?            @db.Text
  supplierAssessment           String?            @db.Text
  supplierException            Boolean            @default(false)
  supplierExceptionReason      String?            @db.Text
  supplierExceptionBy          String?
  supplierExceptionAt          DateTime?          @db.Date
  verifyAtNextAudit            Boolean            @default(false)
  id                           String             @id @default(uuid())
  qmsRecordId                  String             @unique
  qmsRecord                    QmsRecord          @relation(fields: [qmsRecordId], references: [id], onDelete: Restrict)
  auditType                    AuditType?
  scenario                     AuditScenario?
  status                       AuditStatus        @default(DRAFT)
  planningStatus               AuditPlanningStatus @default(UNCLASSIFIED)
  outsidePlanReason            String?            @db.Text
  planEntryId                  String?            @unique
  planEntry                    AuditPlanEntry?    @relation(fields: [planEntryId], references: [id], onDelete: Restrict)
  title                        String?            @db.Text
  scope                        String?            @db.Text
  referenceText                String?            @db.Text
  externalReference            String?
  auditedEntityName            String?
  auditedEntityAddress         String?            @db.Text
  auditingEntityName           String?
  entityCode                   String?
  codingDepartmentId           String?
  codingDepartment             Department?        @relation("AuditCodingDepartment", fields: [codingDepartmentId], references: [id], onDelete: Restrict)
  codingDepartmentCodeSnapshot String?
  codingDepartmentNameSnapshot String?
  plannedDate                  DateTime?          @db.Date
  performedDate                DateTime?          @db.Date
  openedAt                     DateTime?          @db.Date
  closedAt                     DateTime?          @db.Date
  modality                     AuditModality?
  internalObservations         String?            @db.Text
  dataQualityStatus            DataQualityStatus  @default(INCOMPLETE)
  createdByText                String?
  updatedByText                String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  departments                  AuditDepartment[]
  participants                 AuditParticipant[]
  findings                     AuditFinding[]
  followups                    AuditFollowup[]

  @@index([status, plannedDate])
  @@index([auditType, plannedDate])
  @@index([performedDate])
  @@index([scenario])
}

model AuditAnnualPlan {
  technicalApproverName String?
  qualityApproverName String?
