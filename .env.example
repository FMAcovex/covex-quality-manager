# Configuración exclusiva de desarrollo local.
APP_ENV="development"

# Coincide con compose.yaml. Sustituir en cualquier entorno no local.
DATABASE_URL="postgresql://covex:covex_dev@localhost:5432/covex_quality?schema=public"

# Orígenes adicionales seguros para Server Actions detrás de proxies/reverse proxies.
# En desarrollo, localhost:3000 y 127.0.0.1:3000 se permiten automáticamente para Codespaces.
# En otros entornos, declarar aquí solo dominios controlados, separados por comas y sin protocolo.
SERVER_ACTION_ALLOWED_ORIGINS=""

# Solo herramientas offline de datos históricos/ficticios; no autentica operaciones web.
DEFAULT_ACTOR_NAME="Usuario demo"

# Identidad corporativa 4B1: valores definitivos gestionados por IT fuera de Git.
AUTH_PROVIDER="entra"
AUTH_ORIGIN=""
AUTH_ENTRA_TENANT_ID=""
AUTH_ENTRA_CLIENT_ID=""
AUTH_ENTRA_CLIENT_SECRET=""
# Nunca habilitar identidad sintética en producción.
AUTH_SYNTHETIC_IDENTITY="0"

# Plantillas controladas: se instalan en la base de datos con «pnpm templates:install -- <carpeta>» (D-099),
# con «Instalar plantillas» en Configuración → Versiones (D-105) o, al arrancar, desde esta carpeta (D-107).
# Los archivos de la carpeta no se versionan en Git.
TEMPLATE_INSTALL_DIR="plantillas"

# Datos ficticios para demo local. El script demo:seed se bloquea si no está a true
# y también se bloquea siempre con APP_ENV=production.
ALLOW_DEMO_DATA="true"
