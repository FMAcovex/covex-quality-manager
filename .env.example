# Configuración exclusiva de desarrollo local.
APP_ENV="development"

# Coincide con compose.yaml. Sustituir en cualquier entorno no local.
DATABASE_URL="postgresql://covex:covex_dev@localhost:5432/covex_quality?schema=public"

# Identidad manual provisional. Microsoft Entra se incorpora en una fase posterior.
DEFAULT_ACTOR_NAME="Usuario demo"

# Plantillas oficiales de Desviaciones v06. Si se omiten, se usan las rutas por defecto en templates/deviations/v06.
DEVIATION_ANNEX_III_TEMPLATE="./templates/deviations/v06/Anexo III Informe Desviaciones 06.docx"
DEVIATION_ANNEX_V_TEMPLATE="./templates/deviations/v06/Anexo_V_Listado_de_Desviaciones_06.xlsx"

# Plantillas controladas CAPA GC-00/030/05 (opcionales si se instalan en rutas por defecto).
CAPA_ANNEX_III_TEMPLATE=""
CAPA_ANNEX_IV_TEMPLATE=""

# Datos ficticios para demo local. El script demo:seed se bloquea si no está a true
# y también se bloquea siempre con APP_ENV=production.
ALLOW_DEMO_DATA="true"
