{
  "name": "covex-quality-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "quality": "pnpm db:validate && pnpm db:generate && pnpm lint && pnpm test && pnpm build",
    "db:push": "prisma db push",
    "db:smoke": "tsx scripts/smoke-db.ts",
    "templates:install": "tsx scripts/install-document-templates.ts",
    "import:deviations": "tsx scripts/import-historical-deviations.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^5.2.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
