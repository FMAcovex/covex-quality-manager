server {
    listen 443 ssl;
    server_tokens off;
    server_name ${COVEX_DNS};
    if ($host != "${COVEX_DNS}") { return 444; }
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 16m;
    access_log off;
    error_log /dev/stderr crit;
    # Internal probes access the app directly; no public health inventory.
    location = /api/health { deny all; }
    location / {
        proxy_pass http://${COVEX_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${COVEX_DNS};
        proxy_set_header X-Forwarded-Host ${COVEX_DNS};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_hide_header X-Powered-By;
        proxy_read_timeout 60s;
    }
}
