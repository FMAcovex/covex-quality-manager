  "status_directory": "/var/lib/covex-backup",
  "command_timeout_seconds": 3600,
  "approved_recovery_hosts": ["recovery.example.invalid"],
  "source": {"host": "database.example.invalid", "port": 5432, "database": "covex_quality", "user": "covex_backup", "passfile": "/etc/covex/backup.pgpass", "sslmode": "verify-full", "sslrootcert": "/etc/covex/database-ca.pem"},
  "recovery": {"host": "recovery.example.invalid", "port": 5432, "database": "postgres", "user": "covex_recovery", "passfile": "/etc/covex/recovery.pgpass", "sslmode": "verify-full", "sslrootcert": "/etc/covex/database-ca.pem"}
