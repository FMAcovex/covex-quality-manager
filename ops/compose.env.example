# Fictitious candidate; replace privately after IT approval, never commit the real file.
COVEX_STACK_NAME=covex-quality
COVEX_POSTGRES_IMAGE=postgres:16-bookworm
COVEX_APP_IMAGE=covex-quality:APPROVED_COMMIT_SHA
COVEX_PROXY_IMAGE=nginx:stable-bookworm
COVEX_APP_ENV_FILE=/etc/covex/production.env
COVEX_ASSETS_DIR=/opt/covex/assets/templates
COVEX_LISTEN_IP=127.0.0.1
COVEX_DNS=quality.example.invalid
COVEX_TLS_DIR=/etc/covex/https
COVEX_PG_VOLUME=covex-quality-approved-data
COVEX_POSTGRES_PASSWORD_FILE=/etc/covex/secrets/postgres-password
COVEX_DATABASE_URL_FILE=/etc/covex/secrets/database-url
COVEX_ENTRA_SECRET_FILE=/etc/covex/secrets/entra-secret
COVEX_PG_CERT_FILE=/etc/covex/postgres/server.crt
COVEX_PG_KEY_FILE=/etc/covex/postgres/server.key
COVEX_PG_CA_FILE=/etc/covex/postgres/ca.crt
