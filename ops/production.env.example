# Fictitious template. IT supplies private values outside Git.
NODE_ENV=production
APP_ENV=production
ALLOW_DEMO_DATA=false
AUTH_PROVIDER=entra
AUTH_SYNTHETIC_IDENTITY=0
AUTH_ORIGIN=https://quality.example.invalid
AUTH_ENTRA_TENANT_ID=11111111-1111-4111-8111-111111111111
AUTH_ENTRA_CLIENT_ID=22222222-2222-4222-8222-222222222222
# Docker: secrets in *_FILE are supplied by Compose.
# Native: root-owned EnvironmentFile supplies the two secrets or private *_FILE paths.
# No demo, default actor, test issuer or bootstrap in this file.
# SERVER_ACTION_ALLOWED_ORIGINS is a build-time setting. Same-origin proxy needs none.
# D-107 (native only; Compose already sets it): read-only folder with the controlled templates,
# installed automatically at startup. Never replaces an installed version.
# TEMPLATE_INSTALL_DIR=/opt/covex/current/templates
